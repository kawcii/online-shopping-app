<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bigv_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- BIG V Logo -->
        <ImageView
            android:id="@+id/imgWelcomeLogo"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="24dp"
            android:contentDescription="BIG V Supermarket Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/big_v_logo" />

        <!-- Store Name -->
        <TextView
            android:id="@+id/txtWelcomeStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:text="BIG V SUPERMARKET"
            android:textColor="@color/bigv_brown"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Welcome Card Block -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bigv_white"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Welcome Message -->
                <TextView
                    android:id="@+id/txtWelcomeMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:text="Welcome to BIG V!"
                    android:textColor="@color/bigv_dark_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Description -->
                <TextView
                    android:id="@+id/txtWelcomeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Shop groceries, electronics, clothing and household items all in one place."
                    android:textColor="@color/bigv_dark_text"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Enter Shop Button -->
        <Button
            android:id="@+id/btnEnterShop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/bigv_yellow"
            android:fontFamily="@font/montserrat"
            app:cornerRadius="8dp"
            android:text="ENTER SHOP"
            android:textColor="@color/bigv_brown"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
