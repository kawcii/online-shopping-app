<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bigv_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Store Name -->
        <TextView
            android:id="@+id/txtHomeStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BIG V SUPERMARKET"
            android:textColor="@color/bigv_brown"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- BIG V Logo -->
        <ImageView
            android:id="@+id/imgHomeLogo"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:contentDescription="BIG V Supermarket Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/big_v_logo" />

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/txtHomeWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Welcome! What would you like to shop for today?"
            android:textColor="@color/bigv_dark_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- View Products Button -->
        <Button
            android:id="@+id/btnViewProducts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/bigv_yellow"
            android:text="VIEW PRODUCTS"
            android:textColor="@color/bigv_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Categories Button -->
        <Button
            android:id="@+id/btnCategories"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/bigv_yellow"
            android:text="CATEGORIES"
            android:textColor="@color/bigv_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Shopping Cart Button -->
        <Button
            android:id="@+id/btnShoppingCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/bigv_yellow"
            android:text="SHOPPING CART"
            android:textColor="@color/bigv_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>