<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bigv_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Store Name -->
        <TextView
            android:id="@+id/txtHomeStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:text="BIG V SUPERMARKET"
            android:textColor="@color/bigv_brown"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- BIG V Logo -->
        <ImageView
            android:id="@+id/imgHomeLogo"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:contentDescription="BIG V Supermarket Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/big_v_logo" />

        <!-- Welcome Card Block -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bigv_white"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtHomeWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:text="Welcome! What would you like to shop for today?"
                    android:textColor="@color/bigv_dark_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnViewProducts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/bigv_yellow"
            android:fontFamily="@font/montserrat"
            app:cornerRadius="8dp"
            android:text="VIEW PRODUCTS"
            android:textColor="@color/bigv_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCategories"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/bigv_yellow"
            android:fontFamily="@font/montserrat"
            app:cornerRadius="8dp"
            android:text="CATEGORIES"
            android:textColor="@color/bigv_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShoppingCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/bigv_yellow"
            android:fontFamily="@font/montserrat"
            app:cornerRadius="8dp"
            android:text="SHOPPING CART"
            android:textColor="@color/bigv_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
